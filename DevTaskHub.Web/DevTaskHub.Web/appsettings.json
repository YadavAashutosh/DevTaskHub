{
  "KeyVault": {
    "VaultUri": "https://devtaskhub-vault.vault.azure.net/"
  },
  "JwtSettings": {
    "Issuer": "DevTaskHubApi",
    "Audience": "DevTaskHubClient",
    "DurationInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}