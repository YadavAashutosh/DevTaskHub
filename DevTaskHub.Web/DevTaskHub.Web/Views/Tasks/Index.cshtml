@model IEnumerable<DevTaskHub.Web.DTOs.Tasks.TaskDto>
@{
    ViewData["Title"] = "Tasks List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 Developer Tasks</h2>
        <a asp-action="Create" class="btn btn-primary">+ Create New Task</a>
    </div>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Priority</th>
                <th>GitHub PR #</th>
                <th>Project ID</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var task in Model)
                {
                    <tr>
                        <td class="fw-bold">@task.Title</td>
                        <td>@(task.Description ?? "No description")</td>
                        <td>
                            <span class="badge bg-info text-dark">@task.Status</span>
                        </td>
                        <td>
                            <span class="badge @(task.Priority == "High" ? "bg-danger" : task.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                @task.Priority
                            </span>
                        </td>
                        <td>
                            @if (task.GitHubPrNumber.HasValue)
                            {
                                <span class="badge bg-dark">#@task.GitHubPrNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </td>
                        <td>Project #@task.ProjectId</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No tasks available. Click "Create New Task" to add one!</td>
                </tr>
            }
        </tbody>
    </table>
</div>